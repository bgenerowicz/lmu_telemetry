# Copy to deploy/.env on the server and fill in. Never commit .env.

# The server's public address (used in Steam sign-in redirects), including the
# /lmu path it is served under (see lmu.caddy).
LMU_PUBLIC_URL=https://vps-534a6b72.vps.ovh.net/lmu

# Optional: a Steam Web API key (https://steamcommunity.com/dev/apikey) to show
# Steam display names. Without it, names come from the first sign-in.
STEAM_API_KEY=

# The loopback port Caddy proxies to (docker compose reads this; keep it in
# step with lmu.caddy).
LMU_PORT=8000

# Limits.
LMU_MAX_UPLOAD_MB=10
LMU_UPLOADS_PER_HOUR=30

# Never set this on the real server: it allows signing in without Steam.
LMU_DEV_LOGIN=
